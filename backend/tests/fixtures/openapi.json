            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Process lifecycle not ready"
          }
        },
        "summary": "Ready",
        "tags": [
